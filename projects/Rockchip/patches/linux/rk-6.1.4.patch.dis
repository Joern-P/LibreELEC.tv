From a89ecfeca2f0843649674a57c68b0e61dc34c4c5 Mon Sep 17 00:00:00 2001
From: Finley Xiao <finley.xiao@rock-chips.com>
Date: Fri, 21 Jun 2024 15:58:51 +0800
Subject: [PATCH 1897/2766] arm64: dts: rockchip: rk3576: Change ddr and logic
 voltage

Signed-off-by: Finley Xiao <finley.xiao@rock-chips.com>
Change-Id: I20010a5874130865989f61bb58f1f581cc4af107
---
 arch/arm64/boot/dts/rockchip/rk3576.dtsi | 52 +++++++++++++++---------
 1 file changed, 33 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
index 98881632506c9..034f1a73890b6 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -827,35 +827,44 @@
 		rockchip,low-temp-min-volt = <750000>;
 
 		rockchip,leakage-voltage-sel = <
-			1	16	0
-			17	254	1
+			1	10	0
+			11	20	1
+			21	254	2
 		>;
 		opp-528000000 {
 			opp-hz = /bits/ 64 <528000000>;
-			opp-microvolt = <725000 725000 850000>,
-					<725000 725000 800000>;
