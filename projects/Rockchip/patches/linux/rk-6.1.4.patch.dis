diff --git a/include/dt-bindings/display/drm_mipi_dsi.h b/include/dt-bindings/display/drm_mipi_dsi.h
index bc24ce4ddd082..94110c2403137 100644
--- a/include/dt-bindings/display/drm_mipi_dsi.h
+++ b/include/dt-bindings/display/drm_mipi_dsi.h
@@ -28,15 +28,15 @@
 /* enable hsync-end packets in vsync-pulse and v-porch area */
 #define MIPI_DSI_MODE_VIDEO_HSE		(1 << 4)
 /* disable hfront-porch area */
-#define MIPI_DSI_MODE_VIDEO_HFP		(1 << 5)
+#define MIPI_DSI_MODE_VIDEO_NO_HFP	(1 << 5)
 /* disable hback-porch area */
-#define MIPI_DSI_MODE_VIDEO_HBP		(1 << 6)
+#define MIPI_DSI_MODE_VIDEO_NO_HBP	(1 << 6)
 /* disable hsync-active area */
-#define MIPI_DSI_MODE_VIDEO_HSA		(1 << 7)
+#define MIPI_DSI_MODE_VIDEO_NO_HSA	(1 << 7)
 /* flush display FIFO on vsync pulse */
 #define MIPI_DSI_MODE_VSYNC_FLUSH	(1 << 8)
 /* disable EoT packets in HS mode */
-#define MIPI_DSI_MODE_EOT_PACKET	(1 << 9)
+#define MIPI_DSI_MODE_NO_EOT_PACKET	(1 << 9)
 /* device supports non-continuous clock behavior (DSI spec 5.6.1) */
 #define MIPI_DSI_CLOCK_NON_CONTINUOUS	(1 << 10)
 /* transmit data in low power */

From 0fd02a40a7fbe9a8b18f3f47d438da3a8b35c7e7 Mon Sep 17 00:00:00 2001
From: LiuDiMing Lin <fenrir.lin@rock-chips.com>
Date: Fri, 21 Jun 2024 11:05:32 +0800
Subject: [PATCH 1965/2766] arm64: dts: rockchip: rk3576-evb1-cam-4x: ensure
 correct order of the four cameras

Change-Id: I2f2942ce386afddd8391e6fa689c5a6841a8c992
Signed-off-by: LiuDiMing Lin <fenrir.lin@rock-chips.com>
---
 arch/arm64/boot/dts/rockchip/rk3576-evb1-cam-4x.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-evb1-cam-4x.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-evb1-cam-4x.dtsi
index fe773e0b59146..df869e40d645d 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-evb1-cam-4x.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576-evb1-cam-4x.dtsi
@@ -140,7 +140,7 @@
 		pinctrl-0 = <&cam_clk1m0_clk1>;
 		avdd-supply = <&vcc_mipicsi0>;
 		pwdn-gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_HIGH>;
-		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-index = <1>;
 		rockchip,camera-module-facing = "back";
 		rockchip,camera-module-name = "CMK-OT1980-PX1";
 		rockchip,camera-module-lens-name = "SHG102";
@@ -162,7 +162,7 @@
 		pinctrl-names = "default";
 		avdd-supply = <&vcc_mipicsi0>;
 		pwdn-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;/* hw not connect as default */
-		rockchip,camera-module-index = <1>;
+		rockchip,camera-module-index = <0>;
 		rockchip,camera-module-facing = "back";
 		rockchip,camera-module-name = "CMK-OT1980-PX1";
 		rockchip,camera-module-lens-name = "SHG102";

From d78fdd700c8dc71199bbafa54ba349a1d8a15c78 Mon Sep 17 00:00:00 2001
From: LiuDiMing Lin <fenrir.lin@rock-chips.com>
