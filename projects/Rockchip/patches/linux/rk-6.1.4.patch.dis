Subject: [PATCH 2615/2766] media: rockchip: isp: fix dhaz unite for isp39

Change-Id: If7e3587494f454acae74d207c6941c2577439f4b
Signed-off-by: Cai YiWei <cyw@rock-chips.com>
---
 drivers/media/platform/rockchip/isp/isp_params_v39.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/media/platform/rockchip/isp/isp_params_v39.c b/drivers/media/platform/rockchip/isp/isp_params_v39.c
index baaa59e8d880b..e0f28791c1629 100644
--- a/drivers/media/platform/rockchip/isp/isp_params_v39.c
+++ b/drivers/media/platform/rockchip/isp/isp_params_v39.c
@@ -2385,6 +2385,11 @@ isp_dhaz_config(struct rkisp_isp_params_vdev *params_vdev,
 	u32 w = out_crop->width, h = out_crop->height;
 	u32 i, value, ctrl, thumb_row, thumb_col, blk_het, blk_wid;
 
+	if (dev->unite_div > ISP_UNITE_DIV1)
+		w = w / 2 + RKMOUDLE_UNITE_EXTEND_PIXEL;
+	if (dev->unite_div == ISP_UNITE_DIV4)
+		h = h / 2 + RKMOUDLE_UNITE_EXTEND_PIXEL;
+
 	ctrl = isp3_param_read(params_vdev, ISP3X_DHAZ_CTRL, id);
 	ctrl &= ISP3X_DHAZ_ENMUX;
 

