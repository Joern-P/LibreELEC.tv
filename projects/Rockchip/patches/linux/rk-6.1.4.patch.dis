+			     &sai1_sclk_pins
+			     &sai1_sdi_pins
+			     &sai1_sdo0_pins
+			     &sai1_sdo1_pins
+			     &sai1_sdo2_pins
+			     &sai1_sdo3_pins>;
+		status = "disabled";
+	};
+
 	can0: can@ff320000 {
 		compatible = "rockchip,rk3506-canfd", "rockchip,rk3576-canfd";
 		reg = <0xff320000 0x1000>;
@@ -549,6 +595,36 @@
 		status = "disabled";
 	};
 
+	spdif_tx: spdif-tx@ff3a0000 {
