@@ -1060,11 +1084,14 @@ static void rk628_show_csc_info(struct seq_file *s)
 	};
 
 	rk628_i2c_read(rk628, GRF_CSC_CTRL_CON, &val);
-	r2y = ((val & 0x10) == 0x10);
-	y2r = ((val & 0x1) == 0x1);
+	r2y = ((val & BIT(4)) == BIT(4));
+	y2r = ((val & BIT(0)) == BIT(0));
+	csc = ((val & BIT(11)) == BIT(11));
+
+	DEBUG_PRINT("csc:\n");
 
-	csc = (val & 0xc0) >> 6;
