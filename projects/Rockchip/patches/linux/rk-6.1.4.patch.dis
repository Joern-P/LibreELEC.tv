 CONFIG_POWER_RESET=y
@@ -203,7 +211,9 @@ CONFIG_NVMEM_ROCKCHIP_OTP=y
 # CONFIG_FILE_LOCKING is not set
 # CONFIG_DNOTIFY is not set
