index 1498ead15044d..0e2edddf2a971 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-vehicle-evb-v20.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576-vehicle-evb-v20.dtsi
@@ -79,6 +79,7 @@
 	};
 
 	vcc3v3_lcd_n: vcc3v3-lcd0-n {
