Subject: [PATCH 2484/2766] arm64: dts: rockchip: rk3576: Fix trim configure
 for tsadc

Signed-off-by: Ye Zhang <ye.zhang@rock-chips.com>
Change-Id: Id7399f84a7d3f75213528c89151efe1862b1b02e
---
 arch/arm64/boot/dts/rockchip/rk3576.dtsi | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
index 6ffb4f546ca5d..135a34f1b4718 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -4419,35 +4419,35 @@
 		};
 		bigcore_tsadc_trim_h: bigcore-tsadc-trim-h@25 {
 			reg = <0x25 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 		litcore_tsadc_trim_l: litcore-tsadc-trim-l@26 {
 			reg = <0x26 0x1>;
 		};
 		litcore_tsadc_trim_h: litcore-tsadc-trim-h@27 {
 			reg = <0x27 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 		ddr_tsadc_trim_l: ddr-tsadc-trim-l@28 {
 			reg = <0x28 0x1>;
 		};
 		ddr_tsadc_trim_h: ddr-tsadc-trim-h@29 {
 			reg = <0x29 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 		npu_tsadc_trim_l: npu-tsadc-trim-l@2a {
 			reg = <0x2a 0x1>;
 		};
 		npu_tsadc_trim_h: npu-tsadc-trim-h@2b {
 			reg = <0x2b 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 		gpu_tsadc_trim_l: gpu-tsadc-trim-l@2c {
 			reg = <0x2c 0x1>;
 		};
 		gpu_tsadc_trim_h: gpu-tsadc-trim-h@2d {
 			reg = <0x2d 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 		cpub_opp_info: cpub-opp-info@30 {
 			reg = <0x30 0x6>;
@@ -4469,7 +4469,7 @@
 		};
 		soc_tsadc_trim_h: soc-tsadc-trim-h@65 {
 			reg = <0x65 0x1>;
-			bits = <0 1>;
+			bits = <0 2>;
 		};
 	};
 

