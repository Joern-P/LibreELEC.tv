+#define SRST_P_I2C0			190
+#define SRST_I2C0			191
+
+/********Name=SOFTRST_CON12,Offset=0xA30********/
+#define SRST_P_I2C1			192
+#define SRST_I2C1			193
+#define SRST_P_I2C2			194
+#define SRST_I2C2			195
