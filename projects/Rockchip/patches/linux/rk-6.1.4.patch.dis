index e0bee32b72d3d..0d9eb728c49fa 100644
--- a/arch/arm/configs/rk3506_defconfig
+++ b/arch/arm/configs/rk3506_defconfig
@@ -237,6 +237,7 @@ CONFIG_FIQ_DEBUGGER_NO_SLEEP=y
