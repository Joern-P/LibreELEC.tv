+		reg = <0x34>;
+		sound-name-prefix = "ES7202-3";
+	};
+
 	es8388_0: es8388@11 {
 		#sound-dai-cells = <0>;
 		compatible = "everest,es8388", "everest,es8323";
@@ -411,6 +452,16 @@
 	};
 };
 
+&pdm {
+	status = "disabled";
+	pinctrl-names = "default";
