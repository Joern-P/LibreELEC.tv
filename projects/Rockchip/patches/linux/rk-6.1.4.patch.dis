 	    (req.mmu_info.dst_mmu_flag & 1) || (req.mmu_info.els_mmu_flag & 1)) {
 		if (scheduler->data->mmu != RGA_MMU) {
-			rga_err("core[%d] has no MMU, please use physically contiguous memory.\n",
