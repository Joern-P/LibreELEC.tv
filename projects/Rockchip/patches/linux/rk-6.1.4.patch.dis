 			(1 << data->max_downscale_factor), (1 << data->max_upscale_factor),
 			sw, sh, dw, dh);
 
@@ -285,7 +286,7 @@ int rga_job_assign(struct rga_job *job)
 	/* assigned by userspace */
 	if (rga_base->core > RGA_NONE_CORE) {
