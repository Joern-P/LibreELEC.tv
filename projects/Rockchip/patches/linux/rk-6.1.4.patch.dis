-			rockchip,bit-shift = <3>;
-		};
-
-		pvtpll_core: pvtpll-core@ff840000 {
-			compatible = "rockchip,rk3506-core-pvtpll", "syscon";
-			reg = <0xff840000 0x100>;
-			#clock-cells = <0>;
-			clock-output-names = "clk_core_pvtpll";
