+		interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru MCLK_SAI3>, <&cru HCLK_SAI3>;
+		clock-names = "mclk", "hclk";
+		dmas = <&dmac1 6>, <&dmac1 7>;
+		dma-names = "tx", "rx";
+		resets = <&cru SRST_M_SAI3>, <&cru SRST_H_SAI3>;
+		reset-names = "m", "h";
