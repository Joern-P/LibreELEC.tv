 			vop2_disable_all_planes_for_crtc(crtc);
@@ -13892,39 +13962,6 @@ static struct devfreq_governor devfreq_vop2_ondemand = {
 	.event_handler = devfreq_vop2_ondemand_handler,
 };
 
