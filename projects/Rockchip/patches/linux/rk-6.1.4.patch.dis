@@ -408,8 +408,8 @@ static int serdes_i2c_probe(struct i2c_client *client,
 			       __func__, dev->of_node->name, serdes->reg_hw, serdes->reg_use);
 		ret = serdes_set_i2c_address(serdes, serdes->reg_hw,
