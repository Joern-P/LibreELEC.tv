 		}
@@ -2830,18 +2831,18 @@ static int rga2_init_reg(struct rga_job *job)
 
 	ret = rga2_gen_reg_info(scheduler, (uint8_t *)job->cmd_buf->vaddr, &req);
 	if (ret < 0) {
-		rga_err("gen reg info error\n");
