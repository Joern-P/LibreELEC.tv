@@ -18,6 +18,11 @@ static void show_hw(struct seq_file *p, struct rkvpss_hw_dev *hw)
 	int i;
 	u32 val, mask;
 
+	if (hw->dev->power.usage_count.counter <= 0) {
+		seq_printf(p, "\n%s\n", "HW close");
