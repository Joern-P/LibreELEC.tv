 #endif
diff --git a/include/uapi/linux/rk_hdmirx_config.h b/include/uapi/linux/rk_hdmirx_config.h
index 376d271b39bc4..241d89a21a990 100644
--- a/include/uapi/linux/rk_hdmirx_config.h
+++ b/include/uapi/linux/rk_hdmirx_config.h
@@ -58,6 +58,12 @@ enum hdmirx_edid_mode {
 	HDMIRX_EDID_4K60HZ_YUV420,
 };
 
+enum user_color_range {
