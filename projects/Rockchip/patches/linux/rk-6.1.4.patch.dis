 		#pwm-cells = <3>;
 		status = "disabled";
 	};
@@ -1612,8 +1612,8 @@
 		compatible = "rockchip,rk3506-pwm", "rockchip,rk3576-pwm";
 		reg = <0xff932000 0x200>;
 		interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
-		clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>;
-		clock-names = "pwm", "pclk";
