From efb2e22117c324a83f0ed91a3c5f9637ac35ec12 Mon Sep 17 00:00:00 2001
From: Zhibin Huang <zhibin.huang@rock-chips.com>
Date: Thu, 8 Aug 2024 09:41:23 +0800
Subject: [PATCH 2617/2766] phy: rockchip: mipi-dcphy: optimize pll and ssc
 calculation

Type: Fix
Redmine ID: N/A
Associated modifications: N/A
Test: N/A

Signed-off-by: Zhibin Huang <zhibin.huang@rock-chips.com>
Change-Id: If77c1e6526041fdeae07bdc174cddf01bbee4f49
---
 .../phy/rockchip/phy-rockchip-samsung-dcphy.c | 153 ++++++++++--------
 .../phy/rockchip/phy-rockchip-samsung-dcphy.h |   2 +-
 2 files changed, 84 insertions(+), 71 deletions(-)

diff --git a/drivers/phy/rockchip/phy-rockchip-samsung-dcphy.c b/drivers/phy/rockchip/phy-rockchip-samsung-dcphy.c
index 48464ad103932..1122fd63e40d5 100644
--- a/drivers/phy/rockchip/phy-rockchip-samsung-dcphy.c
+++ b/drivers/phy/rockchip/phy-rockchip-samsung-dcphy.c
@@ -1373,19 +1373,7 @@ static void samsung_mipi_dcphy_pll_configure(struct samsung_mipi_dcphy *samsung)
 {
 	regmap_update_bits(samsung->regmap, PLL_CON0, S_MASK | P_MASK,
 			   S(samsung->pll.scaler) | P(samsung->pll.prediv));
-
