+	{IMX219_TABLE_END, 0x00},
 };
 
 /* MCLK:24MHz  1920x1080  30fps   MIPI LANE2 */
@@ -1101,7 +1108,7 @@ static int imx219_probe(struct i2c_client *client,
 	ret = v4l2_async_register_subdev_sensor(sd);
 	if (ret < 0)
 		return ret;
