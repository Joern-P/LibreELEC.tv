+		(struct kbase_hwcnt_backend_csf_if_fw_ctx *)ctx;
+
+	/* Mark performance counters collection as enabled */
+	set_bit(KBASE_GPU_PERF_COUNTERS_COLLECTION_ENABLED,
+		&fw_ctx->kbdev->pm.backend.gpu_sleep_allowed);
