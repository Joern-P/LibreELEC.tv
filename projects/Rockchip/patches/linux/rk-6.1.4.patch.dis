--- a/arch/arm/boot/dts/rk3502.dtsi
+++ b/arch/arm/boot/dts/rk3502.dtsi
@@ -1324,6 +1324,13 @@
 		rockchip,grf = <&grf>;
 		#clock-cells = <1>;
 		#reset-cells = <1>;
