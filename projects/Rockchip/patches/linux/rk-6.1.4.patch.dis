+			if (kbase_pm_is_gpu_lost(kbdev))
+				res = 1;
+
+			switch (suspend_handler) {
+			case KBASE_PM_SUSPEND_HANDLER_DONT_INCREASE:
+				res = 1;
+				break;
+			case KBASE_PM_SUSPEND_HANDLER_DONT_REACTIVATE:
+				if (kbdev->pm.active_count == 0)
