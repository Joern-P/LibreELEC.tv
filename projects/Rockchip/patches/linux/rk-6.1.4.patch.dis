 }
 EXPORT_SYMBOL_GPL(btrtl_free);
@@ -700,10 +953,11 @@ struct btrtl_device_info *btrtl_initialize(struct hci_dev *hdev,
 	struct hci_rp_read_local_version *resp;
 	char cfg_name[40];
