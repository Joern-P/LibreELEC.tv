+++ b/arch/arm/boot/dts/rk3506.dtsi
@@ -38,6 +38,7 @@
 		spi0 = &spi0;
 		spi1 = &spi1;
 		spi2 = &fspi;
+		spi3 = &flexbus_fspi;
 	};
 
 	clocks {
