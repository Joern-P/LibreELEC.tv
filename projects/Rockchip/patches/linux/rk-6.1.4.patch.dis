-	{0x0161, 0xC4},		/* FRM_LENGTH_A[7:0] */
-	{0x0162, 0x0D},		/* LINE_LENGTH_A[15:8] */
-	{0x0163, 0x78},		/* LINE_LENGTH_A[7:0] */
