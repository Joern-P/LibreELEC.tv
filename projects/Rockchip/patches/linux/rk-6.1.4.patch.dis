From 8caaab4b83bf8091d9f6d77a265ca3b15b416711 Mon Sep 17 00:00:00 2001
From: Zain Wang <wzz@rock-chips.com>
Date: Mon, 22 Jul 2024 15:06:07 +0800
Subject: [PATCH 2169/2766] ARM: dts: rockchip: rk3506: Add status "okay"
 property at queue for gmac

The queue nodes will be deleted if
CONFIG_DTC_OMIT_EMPTY=y, the driver cannot get it, add
status "okay" attributes to avoid deletion.

Change-Id: I5405c85d549289572807a6387fda00f074d7b1aa
Signed-off-by: Zain Wang <wzz@rock-chips.com>
Signed-off-by: David Wu <david.wu@rock-chips.com>
---
 arch/arm/boot/dts/rk3506.dtsi | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/arch/arm/boot/dts/rk3506.dtsi b/arch/arm/boot/dts/rk3506.dtsi
index ca19464fd3f98..3fcf7ab090f64 100644
--- a/arch/arm/boot/dts/rk3506.dtsi
+++ b/arch/arm/boot/dts/rk3506.dtsi
@@ -973,12 +973,16 @@
 
 		gmac0_mtl_rx_setup: rx-queues-config {
 			snps,rx-queues-to-use = <1>;
-			queue0 {};
+			queue0 {
+				status = "okay";
+			};
 		};
 
 		gmac0_mtl_tx_setup: tx-queues-config {
 			snps,tx-queues-to-use = <1>;
-			queue0 {};
+			queue0 {
+				status = "okay";
+			};
 		};
 	};
 
@@ -1020,12 +1024,16 @@
 
 		gmac1_mtl_rx_setup: rx-queues-config {
 			snps,rx-queues-to-use = <1>;
