+		.scale_down_mode = RGA_SCALE_DOWN_NONE,
+		.rd_mode = RGA_RASTER_MODE,
+
+	},
+};
+
 const struct rga_win_data rga2p_win_data[] = {
 	{
 		.name = "rga2p-src0",
@@ -537,6 +572,30 @@ const struct rga_hw_data rga2e_1106_data = {
