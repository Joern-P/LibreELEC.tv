From 87108d5ab4528dc494c0fb6228c84e2af447fd73 Mon Sep 17 00:00:00 2001
From: Ye Zhang <ye.zhang@rock-chips.com>
Date: Wed, 18 Sep 2024 16:05:21 +0800
Subject: [PATCH 2494/2766] ARM: dts: rockchip: rk3506-pinctrl: Fix driver
 strengths of some SPI IOs

Fixes: 68cf3d9c4679 ("ARM: dts: rockchip: rk3506-pinctrl: Increase driver strengths of some SPI IOs")
Signed-off-by: Ye Zhang <ye.zhang@rock-chips.com>
Change-Id: I0e0d75ab72b0a80853437cb9c2dde53bc87c8dd3
---
 arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi b/arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi
index c636871deb02d..a79e5fb193575 100644
--- a/arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi
+++ b/arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi
@@ -1358,7 +1358,7 @@
 		/omit-if-no-ref/
 		rm_io2_spi1_mosi: rm-io2-spi1-mosi {
 			rockchip,pins =
-				<0 RK_PA2 88 &pcfg_pull_none>;
+				<0 RK_PA2 88 &pcfg_pull_none_drv_level_3>;
 		};
 		/omit-if-no-ref/
 		rm_io2_spi1_miso: rm-io2-spi1-miso {

From faaec9bb5d5a20a2aa56892f936072665277b9e8 Mon Sep 17 00:00:00 2001
From: Ye Zhang <ye.zhang@rock-chips.com>
Date: Wed, 18 Sep 2024 16:20:27 +0800
Subject: [PATCH 2495/2766] ARM: dts: rockchip: rk3506: set DS of pwm pins to
 level1

According to SI report, the default driver strength should be level1.

Signed-off-by: Ye Zhang <ye.zhang@rock-chips.com>
Change-Id: I2d10de82d9b836a479b38b782732a95f79079deb
---
 arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi | 768 ++++++++++-----------
 1 file changed, 384 insertions(+), 384 deletions(-)

