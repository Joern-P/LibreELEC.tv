From a57c7b16a9d32d7cff7305d133e70d6c2bec1808 Mon Sep 17 00:00:00 2001
From: Zhihuan He <huan.he@rock-chips.com>
Date: Tue, 20 Aug 2024 16:55:50 +0800
Subject: [PATCH 2454/2766] ARM: dts: rockchip: Add rk3506-evb1 dsmc-lb-slave
 demo

Change-Id: I483819fa566c0b68f4df9f4aba44dc9369c634c8
Signed-off-by: Zhihuan He <huan.he@rock-chips.com>
---
 arch/arm/boot/dts/Makefile                    |  1 +
 .../dts/rk3506g-evb1-v10-dsmc-lb-slave.dts    | 26 +++++++++++++++++++
 2 files changed, 27 insertions(+)
 create mode 100644 arch/arm/boot/dts/rk3506g-evb1-v10-dsmc-lb-slave.dts

diff --git a/arch/arm/boot/dts/Makefile b/arch/arm/boot/dts/Makefile
index 9c46495783ce4..1c6a631085dff 100644
--- a/arch/arm/boot/dts/Makefile
+++ b/arch/arm/boot/dts/Makefile
@@ -1226,6 +1226,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += \
 	rk3506g-demo-display-control.dtb \
 	rk3506g-evb1-v10.dtb \
 	rk3506g-evb1-v10-amp.dtb \
+	rk3506g-evb1-v10-dsmc-lb-slave.dtb \
 	rk3506g-evb1-v10-dsmc-master.dtb \
 	rk3506g-evb1-v10-flexbus-adc-dac.dtb \
 	rk3506g-evb1-v10-mcu-k350c4516t.dtb \
diff --git a/arch/arm/boot/dts/rk3506g-evb1-v10-dsmc-lb-slave.dts b/arch/arm/boot/dts/rk3506g-evb1-v10-dsmc-lb-slave.dts
new file mode 100644
index 0000000000000..d62a1b9c6bafc
--- /dev/null
+++ b/arch/arm/boot/dts/rk3506g-evb1-v10-dsmc-lb-slave.dts
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2024 Rockchip Electronics Co., Ltd.
+ */
+
+/dts-v1/;
+
+#include "rk3506.dtsi"
+#include "rk3506-evb1-v10.dtsi"
+
+/ {
+	model = "Rockchip RK3506G(QFN128) EVB1 V10 Board + RK EVB Ext RK3506 DSMC to DSMCSLV Convert V10 board + Rockchip RK3506G(QFN128) EVB1 V10 Board";
+	compatible = "rockchip,rk3506g-evb1-v10-dsmc-lb-slave", "rockchip,rk3506";
+};
+
+&dsmc_lb_slave {
+	memory-region = <&dsmc_lb_slave_mem>;
+	status = "okay";
+};
+
+&reserved_memory {
+	dsmc_lb_slave_mem: dsmc-lb-slave-mem@6000000 {
+		compatible = "rockchip,dsmc-lb-slave-mem";
+		reg = <0x6000000 0x2000000>;
+	};
+};

