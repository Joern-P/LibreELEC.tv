 					  u64 *system_time, struct timespec64 *ts)
 {
@@ -100,6 +163,7 @@ void kbase_backend_get_gpu_time_norequest(struct kbase_device *kbdev, u64 *cycle
 		ktime_get_raw_ts64(ts);
 #endif
