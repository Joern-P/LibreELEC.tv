 				   stream->crop.height,
 				   stream->out_fmt.width,
 				   stream->out_fmt.height);
-;
 			seq_printf(p, "\tframe_cnt:%d rate:%dms delay:%dms frameloss:%d buf_cnt:%d\n",
 				   stream->dbg.id,
 				   stream->dbg.interval / 1000 / 1000,

