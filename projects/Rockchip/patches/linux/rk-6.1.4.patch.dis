+++ b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
@@ -2214,12 +2214,12 @@ static int rkvenc_reset(struct mpp_dev *mpp)
 
 	set_bit(mpp->core_id, &queue->core_idle);
 
