+++ b/arch/arm/boot/dts/rk3506-pinctrl-rmio.dtsi
@@ -157,62 +157,62 @@
 		/omit-if-no-ref/
 		rm_io0_pwm0_ch0: rm-io0-pwm0-ch0 {
 			rockchip,pins =
-				<0 RK_PA0 45 &pcfg_pull_none>;
+				<0 RK_PA0 45 &pcfg_pull_none_drv_level_1>;
