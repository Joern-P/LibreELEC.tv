+
+&es8388_sound {
+	status = "okay";
+};
+
 &gt1x {
 	power-supply = <&vcc3v3_lcd_n>;
 	status = "okay";
@@ -104,6 +112,10 @@
 	status = "okay";
 };
 
+&sai1 {
+	status = "okay";
