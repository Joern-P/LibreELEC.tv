 		interrupt-names = "nmi",
 				  "irq0", "irq1", "irq2", "irq3",
 				  "irq4", "irq5", "irq6", "irq7",
@@ -111,7 +117,9 @@
 				  "tint20", "tint21", "tint22", "tint23",
