 arch/arm64/boot/dts/rockchip/rk3576-test5.dtsi       | 10 ++++++----
 arch/arm64/boot/dts/rockchip/rk3576-vehicle-evb.dtsi | 10 ++++++----
 4 files changed, 24 insertions(+), 15 deletions(-)

