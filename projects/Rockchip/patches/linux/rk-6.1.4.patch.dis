-
+	/* 5. signal test and capability settings */
 	if (rk_pcie->is_lpbk) {
 		val = dw_pcie_readl_dbi(pci, PCIE_PORT_LINK_CONTROL);
 		val |= PORT_LINK_LPBK_ENABLE;
@@ -1325,6 +1316,17 @@ static int rk_pcie_really_probe(void *p)
 		rk_pcie->have_rasdes = true;
 	}
 
+	/* 6. software process */
