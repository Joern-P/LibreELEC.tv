From 9d0f681ab6b5db133fdd89a7da1c9734ed93213a Mon Sep 17 00:00:00 2001
From: Wesley Yao <wesley.yao@rock-chips.com>
Date: Wed, 24 Jul 2024 10:49:15 +0800
Subject: [PATCH 2231/2766] ARM: dts: rockchip: rk3506g-evb1: Add flexbus adc &
 dac board

Change-Id: I20dd0fdea7fc8269f809da0d5bec851a9a8126d6
Signed-off-by: Wesley Yao <wesley.yao@rock-chips.com>
---
 arch/arm/boot/dts/Makefile                    |  1 +
 .../dts/rk3506g-evb1-v10-flexbus-adc-dac.dts  | 43 +++++++++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 arch/arm/boot/dts/rk3506g-evb1-v10-flexbus-adc-dac.dts

diff --git a/arch/arm/boot/dts/Makefile b/arch/arm/boot/dts/Makefile
index 3d2f9c0ebc268..1c7cbe47e9337 100644
--- a/arch/arm/boot/dts/Makefile
+++ b/arch/arm/boot/dts/Makefile
@@ -1225,6 +1225,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += \
 	rk3506b-evb1-v10.dtb \
 	rk3506g-evb1-v10.dtb \
 	rk3506g-evb1-v10-amp.dtb \
+	rk3506g-evb1-v10-flexbus-adc-dac.dtb \
 	rk3506g-evb1-v10-mcu-k350c4516t.dtb \
 	rk3506g-evb1-v10-rgb-Q7050ITH2641AA1T.dtb \
 	rk3506g-evb1-v10-sii9022-bt1120-to-hdmi.dtb \
diff --git a/arch/arm/boot/dts/rk3506g-evb1-v10-flexbus-adc-dac.dts b/arch/arm/boot/dts/rk3506g-evb1-v10-flexbus-adc-dac.dts
new file mode 100644
index 0000000000000..20a596bcb43de
--- /dev/null
+++ b/arch/arm/boot/dts/rk3506g-evb1-v10-flexbus-adc-dac.dts
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2024 Rockchip Electronics Co., Ltd.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/mfd/rockchip-flexbus.h>
+#include "rk3506.dtsi"
+#include "rk3506-evb1-v10.dtsi"
+
+/ {
+	model = "Rockchip RK3506G(QFN128) EVB1 V10 Board + RK EVB Ext RK3506 FlexBus Convert V10 Board + RK EVB EXT FLEXBUS ADC CIF V10 + RK EVB EXT FLEXBUS DAC FSPI V10";
+	compatible = "rockchip,rk3506g-evb1-v10-flexbus-adc-dac", "rockchip,rk3506";
+};
+
+&flexbus {
+	rockchip,flexbus0-opmode = <ROCKCHIP_FLEXBUS0_OPMODE_DAC>;
+	rockchip,flexbus1-opmode = <ROCKCHIP_FLEXBUS1_OPMODE_ADC>;
+	status = "okay";
+};
+
+&flexbus_adc {
+	pinctrl-names = "default";
+	/* 14bit ADC device */
+	pinctrl-0 = <&ref_clk1_pins	/* ref_clk is only used for slave-mode */
+		     &flexbus1_clk_pins
+		     &flexbus1_d0_pins &flexbus1_d1_pins &flexbus1_d2_pins &flexbus1_d3_pins
+		     &flexbus1_d4_pins &flexbus1_d5_pins &flexbus1_d6_pins &flexbus1_d7_pins
+		     &flexbus1_d8_pins &flexbus1_d9_pins &flexbus1_d10_pins &flexbus1_d11_pins
+		     &flexbus1_d12_pins &flexbus1_d13_pins>;
+	status = "okay";
+};
+
+&flexbus_dac {
+	pinctrl-names = "default";
+	/* 12bit DAC device */
+	pinctrl-0 = <&flexbus0_clk_pins
+		     &flexbus0_d0_pins &flexbus0_d1_pins &flexbus0_d2_pins &flexbus0_d3_pins
+		     &flexbus0_d4_pins &flexbus0_d5_pins &flexbus0_d6_pins &flexbus0_d7_pins
+		     &flexbus0_d8_pins &flexbus0_d9_pins &flexbus0_d10_pins &flexbus0_d11_pins>;
+	status = "okay";
+};

From 1cfd120ea47eb5528b72832e9ad2f67a3f80d180 Mon Sep 17 00:00:00 2001
From: Elaine Zhang <zhangqing@rock-chips.com>
