 }
 
 static int rga2_init_reg(struct rga_job *job)
@@ -2763,7 +2764,7 @@ static int rga2_init_reg(struct rga_job *job)
 
 	scheduler = job->scheduler;
 	if (unlikely(scheduler == NULL)) {
