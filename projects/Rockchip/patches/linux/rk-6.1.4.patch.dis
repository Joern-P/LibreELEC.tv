+		pinctrl-0 = <&wifi_wake_host>;
+		wifi_chip_type = "rk960";
+		WIFI,host_wake_irq = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
 };
 
