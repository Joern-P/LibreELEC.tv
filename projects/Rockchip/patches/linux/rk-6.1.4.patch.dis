 		rm_io0_spi0_clk: rm-io0-spi0-clk {
 			rockchip,pins =
-				<0 RK_PA0 82 &pcfg_pull_none>;
+				<0 RK_PA0 82 &pcfg_pull_none_drv_level_3>;
 		};
