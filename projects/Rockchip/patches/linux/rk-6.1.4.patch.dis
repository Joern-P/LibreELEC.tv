 		compatible = "regulator-fixed";
 		regulator-name = "vcc3v3_lcd0_n";
 		regulator-boot-on;
@@ -401,14 +402,13 @@
 	status = "okay";
 };
 
-&spi1 {
+&spi0 {
 	status = "okay";
-	max-freq = <50000000>; /* spi internal clk, don't modify */
