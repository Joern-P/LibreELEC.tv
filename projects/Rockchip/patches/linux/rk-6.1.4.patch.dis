+			clock-output-names = "mclk_sai2_to_io";
+			rockchip,bit-shift = <2>;
+		};
+
+		mclkout_sai3: mclkout-sai3@ff288004 {
+			compatible = "rockchip,clk-out";
+			reg = <0xff288004 0x4>;
+			clocks = <&cru MCLK_OUT_SAI3>;
+			#clock-cells = <0>;
+			clock-output-names = "mclk_sai3_to_io";
