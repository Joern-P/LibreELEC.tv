 arch/arm64/boot/dts/rockchip/rk3576.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
index 8803972957d80..643cad655a5a8 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -4272,6 +4272,7 @@
 		interrupts = <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&cru SCLK_FSPI1_X2>, <&cru HCLK_FSPI1>;
 		clock-names = "clk_sfc", "hclk_sfc";
+		rockchip,max-dll = <0xFF>;
 		#address-cells = <1>;
 		#size-cells = <0>;
 		status = "disabled";
@@ -4339,6 +4340,7 @@
 		interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&cru SCLK_FSPI_X2>, <&cru HCLK_FSPI>;
 		clock-names = "clk_sfc", "hclk_sfc";
+		rockchip,max-dll = <0xFF>;
 		#address-cells = <1>;
 		#size-cells = <0>;
 		status = "disabled";

From 793f93d85a586446a9efa9a5c3785b7d29545e52 Mon Sep 17 00:00:00 2001
From: Tao Huang <huangtao@rock-chips.com>
Date: Fri, 9 Aug 2024 15:29:09 +0800
Subject: [PATCH 2306/2766] ASoC: rk817: Sync with upstream

Signed-off-by: Tao Huang <huangtao@rock-chips.com>
Change-Id: I6162f1b433fd6bef619f6cad8df3b1ac8e734c06
---
 sound/soc/codecs/rk817_codec.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/sound/soc/codecs/rk817_codec.c b/sound/soc/codecs/rk817_codec.c
index dbbf90191ddcc..b951044e6755c 100644
--- a/sound/soc/codecs/rk817_codec.c
+++ b/sound/soc/codecs/rk817_codec.c
@@ -4,7 +4,6 @@
 //
 // Copyright (c) 2018, Fuzhou Rockchip Electronics Co., Ltd All rights reserved.
 
-
 #include <linux/clk.h>
 #include <linux/device.h>
 #include <linux/delay.h>
@@ -17,6 +16,7 @@
 #include <sound/core.h>
 #include <sound/pcm_params.h>
 #include <sound/soc.h>
+#include <sound/tlv.h>
 #include "rk817_codec.h"
 
 #ifdef CONFIG_SND_DEBUG
@@ -1263,7 +1263,6 @@ static struct snd_soc_dai_driver rk817_dai[] = {
 		},
 		.ops = &rk817_dai_ops,
 	},
-
 };
 
 static int rk817_suspend(struct snd_soc_component *component)
@@ -1444,6 +1443,8 @@ static int rk817_codec_parse_dt_property(struct device *dev,
 	rk817->adc_for_loopback =
 			of_property_read_bool(node, "adc-for-loopback");
 
+	of_node_put(node);
+
 	return 0;
 }
 
@@ -1514,15 +1515,13 @@ static int rk817_platform_probe(struct platform_device *pdev)
 	}
 
 	return 0;
-err_:
 
+err_:
 	return ret;
 }
 
 static int rk817_platform_remove(struct platform_device *pdev)
 {
-	snd_soc_unregister_component(&pdev->dev);
-
 	return 0;
 }
 
@@ -1557,3 +1556,4 @@ module_platform_driver(rk817_codec_driver);
 MODULE_DESCRIPTION("ASoC RK817 codec driver");
 MODULE_AUTHOR("binyuan <kevan.lan@rock-chips.com>");
 MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:rk817-codec");

From 54359b56caf3a7df236321e0d00c7d46811e0aae Mon Sep 17 00:00:00 2001
From: XiaoTan Luo <lxt@rock-chips.com>
Date: Fri, 12 Jul 2024 14:05:55 +0800
Subject: [PATCH 2307/2766] arm64: dts: rockchip: rk3576: Add pinctrl idle for
 pdm

Signed-off-by: XiaoTan Luo <lxt@rock-chips.com>
Change-Id: Ia1aaf014ae5c393d3e1cc9155c6b7135acc12eb7
---
 .../boot/dts/rockchip/rk3576-pinctrl.dtsi     | 60 +++++++++++++++++++
 arch/arm64/boot/dts/rockchip/rk3576.dtsi      | 20 ++++---
 2 files changed, 72 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-pinctrl.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-pinctrl.dtsi
index 0b0851a7e4ea9..8bce5e14d03b5 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576-pinctrl.dtsi
@@ -5417,6 +5417,66 @@
  * This part is edited handly.
  */
 &pinctrl {
+	pdm0 {
+		/omit-if-no-ref/
+		pdm0m0_clk0_idle: pdm0m0-clk0-idle {
+			rockchip,pins =
+				/* pdm0_clk0_m0 */
+				<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm0m0_clk1_idle: pdm0m0-clk1-idle {
+			rockchip,pins =
+				/* pdm0_clk1_m0 */
+				<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm0m1_clk0_idle: pdm0m1-clk0-idle {
+			rockchip,pins =
+				/* pdm0_clk0_m1 */
+				<1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm0m1_clk1_idle: pdm0m1-clk1-idle {
+			rockchip,pins =
+				/* pdm0_clk1_m1 */
+				<1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	pdm1 {
+		/omit-if-no-ref/
+		pdm1m0_clk0_idle: pdm1m0-clk0-idle {
+			rockchip,pins =
+				/* pdm1_clk0_m0 */
+				<2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm1m0_clk1_idle: pdm1m0-clk1-idle {
+			rockchip,pins =
+				/* pdm1_clk1_m0 */
+				<2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm1m1_clk0_idle: pdm1m1-clk0-idle {
+			rockchip,pins =
+				/* pdm1_clk0_m1 */
+				<4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		/omit-if-no-ref/
+		pdm1m1_clk1_idle: pdm1m1-clk1-idle {
+			rockchip,pins =
+				/* pdm1_clk1_m1 */
+				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
 	pmic {
 		/omit-if-no-ref/
 		pmic_pins: pmic-pins {
diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
index 643cad655a5a8..9fc1f21f87b7a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -2023,13 +2023,15 @@
 		clock-names = "pdm_clk", "pdm_hclk", "pdm_clk_out";
 		dmas = <&dmac0 4>;
 		dma-names = "rx";
-		pinctrl-names = "default";
-		pinctrl-0 = <&pdm0m0_clk0
-			     &pdm0m0_clk1
-			     &pdm0m0_sdi0
+		pinctrl-names = "default", "idle", "clk";
+		pinctrl-0 = <&pdm0m0_sdi0
 			     &pdm0m0_sdi1
 			     &pdm0m0_sdi2
 			     &pdm0m0_sdi3>;
+		pinctrl-1 = <&pdm0m0_clk0_idle
+			     &pdm0m0_clk1_idle>;
+		pinctrl-2 = <&pdm0m0_clk0
+			     &pdm0m0_clk1>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "PDM0";
 		status = "disabled";
@@ -4744,13 +4746,15 @@
 		assigned-clock-parents = <&cru CLK_AUDIO_INT_2>;
 		dmas = <&dmac1 4>;
 		dma-names = "rx";
-		pinctrl-names = "default";
-		pinctrl-0 = <&pdm1m0_clk0
-			     &pdm1m0_clk1
-			     &pdm1m0_sdi0
+		pinctrl-names = "default", "idle", "clk";
+		pinctrl-0 = <&pdm1m0_sdi0
 			     &pdm1m0_sdi1
 			     &pdm1m0_sdi2
 			     &pdm1m0_sdi3>;
+		pinctrl-1 = <&pdm1m0_clk0_idle
+			     &pdm1m0_clk1_idle>;
+		pinctrl-2 = <&pdm1m0_clk0
+			     &pdm1m0_clk1>;
 		power-domains = <&power RK3576_PD_AUDIO>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "PDM1";

From 17a4e1cf2a339a067e70da97e4286aa08f512cb0 Mon Sep 17 00:00:00 2001
From: Hongming Zou <hongming.zou@rock-chips.com>
Date: Tue, 6 Aug 2024 16:49:10 +0800
Subject: [PATCH 2308/2766] input: touchscreen: gslx680_pad support gsl1686

Change-Id: If1ffbb172b63b046496340fd7e90c51dc64d7abf
Signed-off-by: Hongming Zou <hongming.zou@rock-chips.com>
---
 drivers/input/touchscreen/gslx680_pad.c |    5 +-
 drivers/input/touchscreen/gslx680_pad.h | 4760 ++++++++++++++++++++++-
 2 files changed, 4762 insertions(+), 3 deletions(-)

diff --git a/drivers/input/touchscreen/gslx680_pad.c b/drivers/input/touchscreen/gslx680_pad.c
index 56d4795e20f68..c111782b23396 100644
--- a/drivers/input/touchscreen/gslx680_pad.c
+++ b/drivers/input/touchscreen/gslx680_pad.c
@@ -141,6 +141,7 @@ static u16 y_new = 0;
 static struct gsl_touch_chip_info gsl_chip_info[] = {
    {GSL680,GSLX680_FW,ARRAY_SIZE(GSLX680_FW),gsl_config_data_id,ARRAY_SIZE(gsl_config_data_id)},
    {GSL3676,GSL3675B_FW_HK,ARRAY_SIZE(GSL3675B_FW_HK),gsl3678_config_data_id,ARRAY_SIZE(gsl3678_config_data_id)},
+   {GSL1686,GSL1686_FW,ARRAY_SIZE(GSL1686_FW),gsl1686_config_data_id,ARRAY_SIZE(gsl1686_config_data_id)},
 };
 
 
@@ -459,7 +460,7 @@ static int gsl_config_read_proc(struct seq_file *m,void *v)
     return 0;
 }
 
-ssize_t gsl_config_write_proc(struct file *file, const char *buffer, size_t count, loff_t *data)
+static ssize_t gsl_config_write_proc(struct file *file, const char *buffer, size_t count, loff_t *data)
 {
     u8 buf[8] = {0};
     char temp_buf[CONFIG_LEN];
@@ -471,7 +472,7 @@ ssize_t gsl_config_write_proc(struct file *file, const char *buffer, size_t coun
     print_info("[tp-gsl][%s] \n",__func__);
     if(count > 512)
     {
-        pr_err("size not match [%d:%ld]\n", CONFIG_LEN, count);
+        pr_err("size not match [%d:%zu]\n", CONFIG_LEN, count);
         return -EFAULT;
     }
     path_buf=kzalloc(count,GFP_KERNEL);
diff --git a/drivers/input/touchscreen/gslx680_pad.h b/drivers/input/touchscreen/gslx680_pad.h
index aab1786f221ad..3f816e8e364a5 100644
--- a/drivers/input/touchscreen/gslx680_pad.h
+++ b/drivers/input/touchscreen/gslx680_pad.h
@@ -18,7 +18,7 @@ struct fw_data
     u32 val;
 };
 
-#define 	GSL_NOID_VERSION
+#define GSL_NOID_VERSION
