index af31335628376..9eaba1716ec80 100644
--- a/arch/arm/configs/rk3506_defconfig
+++ b/arch/arm/configs/rk3506_defconfig
@@ -76,6 +76,12 @@ CONFIG_DEVTMPFS_MOUNT=y
