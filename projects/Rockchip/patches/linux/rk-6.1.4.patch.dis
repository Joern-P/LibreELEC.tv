 			rockchip,pins =
 				/* vo_lcdc_clk */
-				<1 RK_PA3 1 &pcfg_pull_none>,
+				<1 RK_PA3 1 &pcfg_pull_none_drv_level_4>,
 				/* vo_lcdc_d13 */
 				<1 RK_PB6 1 &pcfg_pull_none>,
 				/* vo_lcdc_d14 */
@@ -1418,11 +1418,224 @@
 		};
 
 		/omit-if-no-ref/
-		rgb3x8_rgb2x8_m0_pins: rgb3x8-rgb2x8-m0-pins {
