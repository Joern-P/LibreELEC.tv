From 4d9932699b2dedfc43c3907465d11284730d87be Mon Sep 17 00:00:00 2001
From: boogie <boogiepop@gmx.com>
Date: Sat, 6 Apr 2024 18:53:00 +0200
Subject: [PATCH 3/3] new settings

---
 system/settings/linux.xml | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/system/settings/linux.xml b/system/settings/linux.xml
index 531974f3f4af9..01ba3aa0b3012 100644
--- a/system/settings/linux.xml
+++ b/system/settings/linux.xml
@@ -193,6 +193,45 @@
           </constraints>
           <control type="spinner" format="string" />
         </setting>
+        <setting id="videoplayer.gui10bit" type="boolean" parent="videoplayer.useprimedecoder" label="10bit GUI Rendering" help="10bit GUI Rendering">
+          <requirement>HAS_GLES</requirement>
+          <visible>false</visible>
+          <level>2</level>
+          <dependencies>
+            <dependency type="enable">
+              <condition setting="videoplayer.useprimerenderer" operator="equals">1</condition>
+            </dependency>
+          </dependencies>
+          <level>3</level>
+          <default>false</default>
+          <control type="toggle" />
+        </setting>
+        <setting id="videoplayer.guimodifiers" type="boolean" parent="videoplayer.useprimedecoder" label="Use Plane Modifiers for GUI Rendering" help="Use Plane Modifiers for GUI Rendering">
+          <requirement>HAS_GLES</requirement>
+          <visible>false</visible>
+          <level>2</level>
+          <dependencies>
+            <dependency type="enable">
+              <condition setting="videoplayer.useprimerenderer" operator="equals">1</condition>
+            </dependency>
+          </dependencies>
+          <level>3</level>
+          <default>false</default>
+          <control type="toggle" />
+        </setting>
+        <setting id="videoplayer.guialpha" type="boolean" parent="videoplayer.useprimedecoder" label="GUI plane with alpha transparency" help="GUI plane with alpha transparency">
+          <requirement>HAS_GLES</requirement>
+          <visible>false</visible>
+          <level>2</level>
+          <dependencies>
+            <dependency type="enable">
+              <condition setting="videoplayer.useprimerenderer" operator="equals">1</condition>
+            </dependency>
+          </dependencies>
+          <level>3</level>
+          <default>true</default>
+          <control type="toggle" />
+        </setting>
       </group>
     </category>
   </section>

