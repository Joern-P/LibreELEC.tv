+      m_pixels[i * 4 + 2] = m_pixels[i * 2];
+      m_pixels[i * 4 + 1] = m_pixels[i * 2];
+      m_pixels[i * 4] = m_pixels[i * 2];
+    }
+    m_format = XB_FMT_A8R8G8B8;
+  }
