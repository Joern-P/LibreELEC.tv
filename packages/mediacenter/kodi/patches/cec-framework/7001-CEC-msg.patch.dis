+    {
+       CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CECSTANDBY);
+       m_cecIsActive = true;
+    }
+    
+    if (!havePauseIdleActivity)
+    {
+       ToggleDPMS(false);
+       WakeUpScreenSaver();
+    }
   }
   else if (maybeScreensaver &&
            elapsed > CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
