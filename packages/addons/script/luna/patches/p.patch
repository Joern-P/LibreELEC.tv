diff -uNr a/resources/launchscripts/Libreelec/launch.sh b/resources/launchscripts/Libreelec/launch.sh
--- a/resources/launchscripts/Libreelec/launch.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/resources/launchscripts/Libreelec/launch.sh	2022-12-15 16:25:35.255158922 +0100
@@ -0,0 +1,10 @@
+#!/usr/bin/sh
+
+killall -STOP kodi.bin
+
+mv logfile logfile.old
+
+(sleep 3; echo 1 > /sys/class/graphics/fb0/blank) &
+moonlight stream -app "$@" >> logfile 2>&1
+
+killall -CONT kodi.bin
