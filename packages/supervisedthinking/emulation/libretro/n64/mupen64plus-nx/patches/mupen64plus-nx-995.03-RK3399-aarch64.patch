diff -uNr a/Makefile b/Makefile
--- a/Makefile	2023-03-13 10:05:24.360809000 +0100
+++ b/Makefile	2023-03-13 10:26:47.360431000 +0100
@@ -391,14 +391,14 @@
    LDFLAGS += -shared -Wl,--version-script=$(LIBRETRO_DIR)/link.T -Wl,--no-undefined -ldl
 
    ifneq (,$(findstring RK33,$(platform)))
-      CPUFLAGS += -march=armv8-a+crc -mfloat-abi=hard -mfpu=neon-fp-armv8
+      ifeq ($(ARCH), aarch64)
+      	 CPUFLAGS += -march=armv8-a+crc+fp
+      else
+      	 CPUFLAGS += -march=armv8-a+crc -mfloat-abi=hard -mfpu=neon-fp-armv8
+      endif
       ifneq (,$(findstring RK3399,$(platform)))
-         CPUFLAGS += -mtune=cortex-a72.cortex-a53
-         ifeq ($(FORCE_GLES),1)
-            GLES = 1
-         else
-            GLES3 = 1
-         endif
+         CPUFLAGS += -mtune=cortex-a72.cortex-a53 
+         GLES3 = 1
       else ifneq (,$(findstring RK3328,$(platform)))
          CPUFLAGS += -mtune=cortex-a53
          GLES = 1
@@ -412,11 +412,20 @@
       endif
    endif
 
-   GL_LIB := -lGLESv2
-   HAVE_NEON = 1
-   WITH_DYNAREC=arm
-   COREFLAGS += -DUSE_GENERIC_GLESV2 -DOS_LINUX
-   ASFLAGS = -f elf -d ELF_TYPE
+   ifeq ($(ARCH), aarch64)
+      GL_LIB := -lGLESv2
+      HAVE_NEON = 0
+      WITH_DYNAREC=aarch64
+      COREFLAGS +=  -DOS_LINUX
+      ASFLAGS = -f elf64 -d ELF_TYPE
+   else
+      GL_LIB := -lGLESv2
+      HAVE_NEON = 1
+      WITH_DYNAREC=arm
+      COREFLAGS += -DUSE_GENERIC_GLESV2 -DOS_LINUX
+      ASFLAGS = -f elf -d ELF_TYPE
+   endif
+
 
 # OS X
 else ifneq (,$(findstring osx,$(platform)))
