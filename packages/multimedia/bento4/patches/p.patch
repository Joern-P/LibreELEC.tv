+                            coding,
+                            dvcc->GetDvProfile(),
+                            dvcc->GetDvLevel());
+            codec = workspace;
+        }
+        printf(",\n");
+        printf("\"dv_codecs_string\":\"");
+        printf("%s", codec.GetChars());
+        printf("\"");
         /* Dolby Vision */
         printf(",\n");
         printf("\"dolby_vision\": {\n");

