PKG_NAME="rkmpp"
PKG_VERSION="9d9aeba533c75f659910c39291df77e1ae3d5193"
PKG_SHA256=""
PKG_ARCH="arm aarch64"
PKG_LICENSE="APL"
PKG_SITE="https://github.com/rockchip-linux/mpp"
PKG_URL="https://github.com/Caesar-github/mpp/archive/$PKG_VERSION.tar.gz"
PKG_DEPENDS_TARGET="toolchain libdrm"
PKG_LONGDESC="rkmpp: Rockchip Media Process Platform (MPP) module"

if [ "$DEVICE" = "RK3328" -o "$DEVICE" = "RK3399" ]; then
  PKG_ENABLE_VP9D="ON"
else
  PKG_ENABLE_VP9D="OFF"
fi

PKG_CMAKE_OPTS_TARGET="-DENABLE_VP9D=$PKG_ENABLE_VP9D \
			-DHAVE_AVSD=ON \
			-DHAVE_JPEGD=ON\
			-DHAVE_H264E=ON\
		       -DRKPLATFORM=ON \
                       -DHAVE_DRM=ON" 

