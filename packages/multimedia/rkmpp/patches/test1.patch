From d24f87edc1cc088003bf67295469964b820fcdc9 Mon Sep 17 00:00:00 2001
From: Lawrence-Tang <tangzongsheng@gmail.com>
Date: Thu, 28 Jun 2018 06:13:13 +0000
Subject: [PATCH] [cmake] support to build MPP on aarch64 target

Signed-off-by: Lawrence-Tang <tangzongsheng@gmail.com>
---
 CMakeLists.txt                          |  7 +++++--
 build/linux/aarch64/make-Makefiles.bash | 16 +---------------
 debian/source/format                    |  1 -
 3 files changed, 6 insertions(+), 18 deletions(-)
 delete mode 100644 debian/source/format

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 263d19c86..5afffbdcf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -97,10 +97,13 @@ elseif(${SYSPROC} STREQUAL "armv7-a_hardfp" OR ${SYSPROC} STREQUAL "armv7l")
     message(STATUS "Detected ARMv7 system processor")
     set(ARM true)
     set(ARMEABI_V7A_HARDFP true)
+    add_definitions(-DARCH_ARM=1 -DDHAVE_ARMV7=1)
 elseif(${SYSPROC} STREQUAL "aarch64" OR ${SYSPROC} STREQUAL "armv8-a")
     message(STATUS "Detected ARMv8 system processor")
-    set(ARM true)
+    set(ARM64 true)
     set(ARMEABI_V8 true)
+    add_definitions(-DARCH_ARM64=1 -DDHAVE_ARMV8=1 -D_FILE_OFFSET_BITS=64)
+    add_definitions(-march=armv8-a -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53)
 else()
     message(STATUS "CMAKE_SYSTEM_PROCESSOR value `${CMAKE_SYSTEM_PROCESSOR}` is unknown")
     message(STATUS "Please add this value near ${CMAKE_CURRENT_LIST_FILE}:${CMAKE_CURRENT_LIST_LINE}")
@@ -153,7 +156,7 @@ if(GCC)
         elseif(ARMEABI_V7A_HARDFP)
             add_definitions(-march=armv7-a -mfloat-abi=hard -mfpu=neon)
         elseif(ARMEABI_V8)
-            add_definitions(-march=armv8-a)
+            add_definitions(-march=armv8-a -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53)
         endif()
     else()
         if(X86 AND NOT X64)
diff --git a/build/linux/aarch64/make-Makefiles.bash b/build/linux/aarch64/make-Makefiles.bash
index a648bc4a4..b49a015b4 100755
--- a/build/linux/aarch64/make-Makefiles.bash
+++ b/build/linux/aarch64/make-Makefiles.bash
@@ -6,24 +6,10 @@ set +e
 MPP_PWD=`pwd`
 MPP_TOP=${MPP_PWD}/../../..
 
-# toolchain detection
-check_cmd(){
-    "$@" >> /dev/null 2>&1
-}
-check_system_arm_linux_gcc(){
-    check_cmd aarch64-linux-gnu-gcc -v
-}
-
 source ../opt_proc.sh
 
-check_system_arm_linux_gcc
-if [ $? -eq 127 ];then
-    MPP_TOOLCHAIN=/usr/bin
-    export PATH=$PATH:${MPP_TOOLCHAIN}
-fi
-
 # generate Makefile
 cmake -DCMAKE_BUILD_TYPE=Release \
-      -DCMAKE_TOOLCHAIN_FILE=./arm.linux.cross.cmake \
+      -DRKPLATFORM=ON \
       -G "Unix Makefiles" \
       ${MPP_TOP}
diff --git a/debian/source/format b/debian/source/format
deleted file mode 100644
index 163aaf8d8..000000000
--- a/debian/source/format
+++ /dev/null
@@ -1 +0,0 @@
-3.0 (quilt)

