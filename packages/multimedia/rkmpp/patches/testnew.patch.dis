@@ -1572,11 +1572,11 @@ MPP_RET hal_vp9d_prob_flag_delta(void *buf, void *dxva)
             }
 
         //intra mode prob  80 x 128 bit
-        for (i = 0; i < INTRA_MODES; i++) { //vp9_kf_y_mode_prob
