From 22bf13b5f290542458e3b3128afdb7e6cf223536 Mon Sep 17 00:00:00 2001
From: nyanmisaka <nst799610810@gmail.com>
Date: Fri, 23 May 2025 23:11:14 +0800
Subject: [PATCH 10/13] fix[buf_slot]: Disable sys_cfg_info warnings for now

Signed-off-by: nyanmisaka <nst799610810@gmail.com>
---
 mpp/base/mpp_buf_slot.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mpp/base/mpp_buf_slot.cpp b/mpp/base/mpp_buf_slot.cpp
index 7a0d17a21..1683e05fc 100644
--- a/mpp/base/mpp_buf_slot.cpp
+++ b/mpp/base/mpp_buf_slot.cpp
@@ -493,6 +493,7 @@ static void generate_info_set(MppBufSlotsImpl *impl, MppFrame frame, RK_U32 forc
 
     if (impl->align_chk_log_en) {
         impl->align_chk_log_en = 0;
+#if 0
         if (legacy_info_set.h_stride_by_pixel != sys_cfg_info_set.h_stride_by_pixel)
             mpp_logi("mismatch h_stride_by_pixel %d - %d\n",
                      legacy_info_set.h_stride_by_pixel,
@@ -509,6 +510,7 @@ static void generate_info_set(MppBufSlotsImpl *impl, MppFrame frame, RK_U32 forc
