+                return rkmpp_get_frame(avctx, frame, MPP_TIMEOUT_NON_BLOCK);
+            } else if (ret < 0) {
+                av_log(avctx, AV_LOG_ERROR, "Failed to get packet: %d\n", ret);
+                return ret;
+            }
+        } else {
+            /* send pending data to decoder */
+            ret = rkmpp_send_packet(avctx, pkt);
+            if (ret == AVERROR(EAGAIN)) {
