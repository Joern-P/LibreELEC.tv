+                return rkmpp_get_frame(avctx, frame, MPP_TIMEOUT_BLOCK);
+            } else if (ret < 0) {
+                av_log(avctx, AV_LOG_ERROR, "Failed to send packet: %d\n", ret);
+                return ret;
+            } else {
+                av_packet_unref(pkt);
+                pkt->size = 0;
+            }
+        }
+    }
 }
 
