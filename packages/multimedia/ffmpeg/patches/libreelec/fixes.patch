@@ -674,6 +673,10 @@ static int rkmpp_get_frame(AVCodecContext *avctx, AVFrame *frame, int timeout)
     MppFrame mpp_frame = NULL;
     int ret;
 
+    /* should not provide ant frame after EOS */
+    if (r->eof)
+        return AVERROR_EOF;
+
     if ((ret = r->mapi->control(r->mctx, MPP_SET_OUTPUT_TIMEOUT, (MppParam)&timeout)) != MPP_OK) {
         av_log(avctx, AV_LOG_ERROR, "Failed to set output timeout: %d\n", ret);
