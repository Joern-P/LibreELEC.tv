From f31ca0bf7613d19ffa112d28579cd38216edf6d4 Mon Sep 17 00:00:00 2001
From: MrFixIt2001 <mrfixit2001@gmail.com>
Date: Mon, 27 Sep 2021 17:33:21 -0400
Subject: [PATCH] dw-hdmi: persist audio enable setting Upstream commit
 https://github.com/torvalds/linux/commit/fadfee3f9d8f114435a8a3e9f83a227600d89de7

---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index e37a626d83..4423457bbf 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -2402,7 +2402,7 @@ static int dw_hdmi_setup(struct dw_hdmi *hdmi, struct drm_display_mode *mode)
 
 		/* HDMI Initialization Step E - Configure audio */
 		hdmi_clk_regenerator_update_pixel_clock(hdmi);
-		hdmi_enable_audio_clk(hdmi, true);
+		hdmi_enable_audio_clk(hdmi, hdmi->audio_enable);
 	}
 
 	/* not for DVI mode */
diff -uNr a/arch/arm64/mm/dma-mapping.c b/arch/arm64/mm/dma-mapping.c
--- a/arch/arm64/mm/dma-mapping.c	2021-07-09 14:54:55.000000000 +0200
+++ b/arch/arm64/mm/dma-mapping.c	2021-10-05 13:34:37.435541173 +0200
@@ -200,7 +200,8 @@
 	dma_addr_t dev_addr;
 
 	dev_addr = swiotlb_map_page(dev, page, offset, size, dir, attrs);
-	if (!is_device_dma_coherent(dev))
+	if (!is_device_dma_coherent(dev) &&
+	    !dma_get_attr(DMA_ATTR_SKIP_CPU_SYNC, attrs))
 		__dma_map_area(phys_to_virt(dma_to_phys(dev, dev_addr)), size, dir);
 
 	return dev_addr;
@@ -211,7 +212,8 @@
 				 size_t size, enum dma_data_direction dir,
 				 struct dma_attrs *attrs)
 {
-	if (!is_device_dma_coherent(dev))
+	if (!is_device_dma_coherent(dev) &&
+	    !dma_get_attr(DMA_ATTR_SKIP_CPU_SYNC, attrs))
 		__dma_unmap_area(phys_to_virt(dma_to_phys(dev, dev_addr)), size, dir);
 	swiotlb_unmap_page(dev, dev_addr, size, dir, attrs);
 }
@@ -224,7 +226,8 @@
 	int i, ret;
 
 	ret = swiotlb_map_sg_attrs(dev, sgl, nelems, dir, attrs);
-	if (!is_device_dma_coherent(dev))
+	if (!is_device_dma_coherent(dev) &&
+	    !dma_get_attr(DMA_ATTR_SKIP_CPU_SYNC, attrs))
 		for_each_sg(sgl, sg, ret, i)
 			__dma_map_area(phys_to_virt(dma_to_phys(dev, sg->dma_address)),
 				       sg->length, dir);
@@ -240,7 +243,8 @@
 	struct scatterlist *sg;
 	int i;
 
-	if (!is_device_dma_coherent(dev))
+	if (!is_device_dma_coherent(dev) &&
+	    !dma_get_attr(DMA_ATTR_SKIP_CPU_SYNC, attrs))
 		for_each_sg(sgl, sg, nelems, i)
 			__dma_unmap_area(phys_to_virt(dma_to_phys(dev, sg->dma_address)),
 					 sg->length, dir);
diff -uNr a/drivers/gpu/drm/drm_prime.c b/drivers/gpu/drm/drm_prime.c
--- a/drivers/gpu/drm/drm_prime.c	2021-07-09 14:54:55.000000000 +0200
+++ b/drivers/gpu/drm/drm_prime.c	2021-10-05 13:31:10.064954393 +0200
@@ -200,11 +200,12 @@
 		if (sgt) {
 			DEFINE_DMA_ATTRS(attrs);
 			dma_set_attr(DMA_ATTR_SKIP_CPU_SYNC, &attrs);
-			if (prime_attach->dir != DMA_NONE)
-				dma_unmap_sg_attrs(attach->dev, sgt->sgl,
-						   sgt->nents,
-						   prime_attach->dir,
-						   &attrs);
+		if (prime_attach->dir != DMA_NONE) {
+			DEFINE_DMA_ATTRS(attrs);
+			dma_set_attr(DMA_ATTR_SKIP_CPU_SYNC, &attrs);
+			dma_unmap_sg_attrs(attach->dev, sgt->sgl, sgt->nents,
+					   prime_attach->dir, &attrs);
+			}
 			sg_free_table(sgt);
 		}
 
diff -uNr a/drivers/soc/rockchip/rockchip_ipa.c b/drivers/soc/rockchip/rockchip_ipa.c
--- a/drivers/soc/rockchip/rockchip_ipa.c	2021-07-09 14:54:55.000000000 +0200
+++ b/drivers/soc/rockchip/rockchip_ipa.c	2021-10-05 14:57:42.352232536 +0200
@@ -58,8 +58,8 @@
 	if (!model_data)
 		return ERR_PTR(-ENOMEM);
 
-	model_node = of_find_compatible_node(dev->of_node,
-					     NULL, "simple-power-model");
+	model_node = of_get_compatible_child(dev->of_node,
+					     "simple-power-model");
 	if (!model_node) {
 		dev_err(dev, "failed to find power_model node\n");
 		ret = -ENODEV;
@@ -111,9 +111,10 @@
 	}
 cal_static_coeff:
 	calculate_static_coefficient(model_data);
-
+	of_node_put(model_node);
 	return model_data;
 err:
+	of_node_put(model_node);
 	kfree(model_data);
 
 	return ERR_PTR(ret);
