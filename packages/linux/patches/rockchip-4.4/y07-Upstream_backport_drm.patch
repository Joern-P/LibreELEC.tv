 		} else {
 			if (rkv_dec_get_fmt(reg->reg) == FMT_H264D)
-				rkvdec_set_clk(pservice, 400 * MHZ, 300 * MHZ,
+				rkvdec_set_clk(pservice, 600 * MHZ, 350 * MHZ,
 					       400 * MHZ, EVENT_ADJUST);
 			else
-				rkvdec_set_clk(pservice, 500 * MHZ, 300 * MHZ,
